# ---- Backend (backend/) ----
# dev | test | staging | prod.
# On dev/test cookies do not require HTTPS and indexes are created at application startup.
# On staging/prod indexes come from a deployment step: uv run ensure-indexes
APP_ENV=dev

# MongoDB. Two non-obvious things in this URL:
#  - directConnection=true: the database is a single-node replica set (required for
#    transactions) but advertises itself by container name; without this flag a client on the
#    host cannot resolve the address.
#  - port 27018: 27017 is often taken by a locally installed mongod, which wins over the
#    Docker port — and the application then quietly talks to a different database.
# Production (Atlas): mongodb+srv://user:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://app:app@localhost:27018/?directConnection=true
MONGODB_DATABASE=app
# Connections per process. The default in PyMongo is 100, which is invisible until it is not:
# what matters is `workers * replicas * pool` against the cluster limit (an Atlas M10 allows 1500).
MONGODB_MAX_POOL_SIZE=50

# Signing secret. Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-32-bytes-hex
CORS_ORIGINS=http://localhost:3000

# Sessions and CSRF — the defaults are fine locally.
SESSION_COOKIE_NAME=session
CSRF_COOKIE_NAME=csrf_token
SESSION_TTL_HOURS=336
# Ceiling for all routes (except the health probes) and a stricter limit for login/registration.
GLOBAL_RATE_LIMIT=300/minute
LOGIN_RATE_LIMIT=10/minute
# Where to keep the rate-limit counters. Empty = process memory, i.e. a PER-INSTANCE limit
# (with two replicas an attacker gets twice the budget).
# `redis://…` = one shared counter for the whole fleet. Port 6380, because 6379 is often taken
# by a locally installed redis. The `async+` prefix is added in code.
RATE_LIMIT_STORAGE_URL=redis://localhost:6380
# How many of YOUR OWN proxies sit in front of the application (nginx, ALB, ingress). This
# number decides which `X-Forwarded-For` entry counts as the real client address — counted from
# the RIGHT, because proxies only append to the end.
#  - 0 (locally, straight to uvicorn): the header is ignored. Trusting it without a proxy lets
#    anyone get a fresh counter bucket by writing a random address.
#  - 1 (a typical nginx/ALB), 2 (e.g. Cloudflare + nginx). Too low and every user shares one
#    bucket; too high and the limit can be bypassed.
TRUSTED_PROXY_HOPS=0

# Probes: /api/health (liveness, no dependencies) and /api/health/ready (checks Mongo and Redis).
# In Kubernetes: livenessProbe -> /api/health, readinessProbe -> /api/health/ready.

# ---- Booking agent (backend/src/app/agent) ----
# Planner backend: an LLM with vision picks one browser action per step.
#   openai      the OpenAI API (OPENAI_API_KEY; OPENAI_BASE_URL for compatible endpoints)
#   claude-cli  Claude Code in `-p` mode on a Claude subscription — dev/demo only, no key needed
#   manual      a human types the action JSON on stdin (record trajectories, write playbooks)
PLANNER=claude-cli
OPENAI_API_KEY=
# openai: gpt-5.5 etc. claude-cli: sonnet | opus | haiku.
PLANNER_MODEL=sonnet
# low | medium | high — "low" keeps per-step latency sane over a long run. Empty = omit.
PLANNER_EFFORT=low
# low | high — screenshot detail sent to the planner. "high" costs ~10x tokens.
PLANNER_IMAGE_DETAIL=low
# camoufox (stealth Firefox, default) | chromium (enables the live.jpg screencast) | firefox
ENGINE=camoufox
# 1 = no visible browser window. Set 0 to watch the agent work locally.
HEADLESS=1
# Where runs/<id>/ (screenshots, status.json, live.jpg) and the trajectory cache are written.
AGENT_VAR_DIR=var/agent
# What happens after the organizer approves the summary in the UI:
#   simulate (default)  no pay click — the run ends "done" with a SIM-xxxxxx reference
#   real                the agent presses pay on the supplier. NEVER in a demo.
AGENT_FINAL_CLICK=simulate
# How long a run waits at the summary for Approve / Reject before handing off (seconds).
AGENT_APPROVAL_TIMEOUT_S=900
# A persistent Camoufox profile reused by every run (cookies, supplier logins). Log in once
# with: cd backend && uv run agent-login --url https://www.intercity.pl. Empty = fresh profile.
AGENT_PROFILE_DIR=
# Optional flat JSON of extra vault values merged into every run started from the UI (e.g.
# real passenger names / phone). Never commit it.
AGENT_VAULT_FILE=
# Show the agent's browser window for runs started from the UI (local debugging).
AGENT_HEADFUL=false
# Step cap for runs started from the UI.
AGENT_MAX_STEPS=40
# Demo only (dev/test): the base URL of this backend. When set, the `demo_rail` supplier (our
# fake rail site at <url>/api/demo-supplier/rail) can be enabled in SUPPLIERS, so a live demo
# never drives the agent at a real carrier. Locally:
# DEMO_SUPPLIER_URL=http://localhost:8000
DEMO_SUPPLIER_URL=

# ---- Trip packages and payments (backend/src/app/ai, backend/src/app/payments) ----
# The supplier plugins (backend/src/app/suppliers), comma-separated:
#   sim_rail, sim_flight, sim_bus, sim_stay, sim_stay_site, sim_activity  simulators (offline)
#   pkp_intercity  real PKP Intercity search + re-quote (plain HTTPS; bought by the agent)
#   demo_rail      the fake rail site above (needs DEMO_SUPPLIER_URL)
SUPPLIERS=sim_rail,sim_flight,sim_bus,sim_stay,sim_activity
# Who researches the three packages:
#   catalog     packages composed deterministically from the suppliers' offers — the default
#   claude-cli  the same packages, described by Claude Code in `-p` mode on a Claude
#               subscription; falls back to the catalogue wording on any failure
RESEARCHER=catalog
# Seconds before a claude-cli description run is abandoned.
RESEARCH_TIMEOUT_S=300
# Who takes the money. Only `fake` (always succeeds) for now; Stripe comes later behind the
# same PaymentProvider port.
PAYMENTS=fake
# Percent a re-quote may move before the shares are re-split. 0 = any change re-splits.
PRICE_TOLERANCE_PERCENT=0

# ---- Frontend (frontend/) ----
# The backend is on the same origin under /api (proxied in dev), so the client generated from
# OpenAPI uses relative URLs and needs no base URL.
# Ports used by `pnpm dev` and Playwright; handy when 3000/8000 are taken by another project.
# WEB_PORT=3000
# API_PORT=8000
